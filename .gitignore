# Виртуальное окружение Python (самое важное!)
venv/
env/

# Кэш Python и скомпилированные скрипты
__pycache__/
*.py[cod]
*$py.class

# Временные файлы редакторов и ОС
.vscode/
.idea/
.DS_Store
Thumbs.db

# Временные бэкапы Protégé (если программа вылетит, она создает файлы с тильдой)
*~
*.bak

# Локальные переменные окружения (если потом прикрутим API ключи)
.env